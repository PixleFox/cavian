// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum ProductType {
  T_SHIRT
  ACCESSORIES
}

enum SleeveType {
  SHORT
  LONG
  SLEEVELESS
}

enum CollarType {
  CIRCLE
  SEVEN
  COLLARED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  PENDING
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  UNDER_CONSIDERATION
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Admin {
  id              Int            @id @default(autoincrement())
  phone_number    String         @unique
  full_name       String
  tokenHash       String         @unique
  isActive        Boolean        @default(true)
  Authority_level Int
  creatorId       Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  ticketMessages  TicketMessage[]
  ticketsCreated  Ticket[]       @relation("TicketsCreatedByAdmin")
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  description      String
  material         String
  gender           Gender
  type             ProductType
  sleeve_type      SleeveType
  collar_type      CollarType
  product_code     String            @unique
  discount_percent Float?            @default(0.0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  variants         ProductVariant[]
  images           ProductImage[]
  categories       ProductCategory[] @relation("ProductToCategory")
}

model ProductVariant {
  id         Int            @id @default(autoincrement())
  product    Product        @relation(fields: [productId], references: [id])
  productId  Int
  size       String
  color      String
  stock      Int            @default(0)
  price      Decimal        @db.Decimal(10, 2)
  sku        String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id           Int             @id @default(autoincrement())
  product      Product         @relation(fields: [productId], references: [id])
  productId    Int
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  variantId    Int?
  image_url    String
  is_main_image Boolean        @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProductCategory {
  id                 Int               @id @default(autoincrement())
  category_name      String
  parent_category    ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  parentCategoryId   Int?
  sub_categories     ProductCategory[] @relation("CategoryHierarchy")
  products           Product[]         @relation("ProductToCategory")
  createdAt          DateTime          @default(now())
}

model DiscountCode {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  percentage   Float
  valid_until  DateTime
  usage_limit  Int
  created_at   DateTime @default(now())
  is_active    Boolean  @default(true)
  orderDiscounts OrderDiscount[]
}

model User {
  id               Int            @id @default(autoincrement())
  full_name        String
  phone_number     String         @unique
  Main_Address     String?
  email            String         @unique
  national_id      String         @unique
  bank_card_number String         @unique
  birth_date       DateTime
  referral_code    String?        @unique
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  last_login       DateTime?
  last_logout      DateTime?
  Level            Int            @default(1)
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
  addresses        UserAddress[]
  orders           Order[]
  payments         Payment[]
}

model Ticket {
  id           Int            @id @default(autoincrement())
  user_id      Int
  admin_id     Int?
  subject      String
  status       TicketStatus   @default(OPEN)
  created_at   DateTime       @default(now())
  phone_number String
  user         User           @relation(fields: [user_id], references: [id])
  admin        Admin?         @relation("TicketsCreatedByAdmin", fields: [admin_id], references: [id])
  messages     TicketMessage[]
}

model TicketMessage {
  id         Int       @id @default(autoincrement())
  ticket_id  Int
  sender_type String   @default("USER")
  message    String
  created_at DateTime  @default(now())
  admin_id   Int?
  user_id    Int?
  ticket     Ticket    @relation(fields: [ticket_id], references: [id])
  admin      Admin?    @relation(fields: [admin_id], references: [id])
  user       User?     @relation(fields: [user_id], references: [id])
}

model UserAddress {
  id              Int      @id @default(autoincrement())
  address_type    String
  city            String
  state_province  String
  street          String
  block           String?
  postal_code     String
  is_main_address Boolean  @default(false)
  user_id         Int
  user            User     @relation(fields: [user_id], references: [id])
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Payment {
  id                     Int           @id @default(autoincrement())
  user_id                Int
  gateway_name           String
  gateway_transaction_id String
  status                 PaymentStatus @default(PENDING)
  processed_at           DateTime?
  user                   User          @relation(fields: [user_id], references: [id])
  order                  Order?        @relation(fields: [order_id], references: [id])
  order_id               Int?          @unique // Mark as unique for one-to-one relationship
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Order {
  id                 Int               @id @default(autoincrement())
  user_id            Int
  address_id         Int
  subtotal_amount    Decimal           @db.Decimal(10, 2)
  shipping_cost      Decimal           @db.Decimal(10, 2)
  total_amount       Decimal           @db.Decimal(10, 2)
  order_status       OrderStatus       @default(PENDING)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  user               User              @relation(fields: [user_id], references: [id])
  address            UserAddress       @relation(fields: [address_id], references: [id])
  payment            Payment?          // No @relation attribute here
  payment_id         Int?              @unique // Mark as unique for one-to-one relationship
  items              OrderItem[]
  discounts          OrderDiscount[]
  statusHistory      OrderStatusHistory[]
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  order_id       Int
  variant_id     Int
  quantity       Int
  price_at_order Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  order          Order    @relation(fields: [order_id], references: [id])
  variant        ProductVariant @relation(fields: [variant_id], references: [id])
}

model OrderDiscount {
  id             Int      @id @default(autoincrement())
  order_id       Int
  discount_code  String
  applied_amount Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  order          Order    @relation(fields: [order_id], references: [id])
  discount       DiscountCode @relation(fields: [discount_code], references: [code])
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  order_id    Int
  old_status  OrderStatus
  new_status  OrderStatus
  changed_at  DateTime    @default(now())
  order       Order       @relation(fields: [order_id], references: [id])
}